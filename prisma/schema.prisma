generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  ASSET_MANAGER
  DEPARTMENT_HEAD
  EMPLOYEE
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
}

enum AssetCondition {
  NEW
  GOOD
  FAIR
  POOR
  DAMAGED
}

enum AssetStatus {
  AVAILABLE
  ALLOCATED
  RESERVED
  UNDER_MAINTENANCE
  LOST
  RETIRED
  DISPOSED
}

enum AllocationStatus {
  ACTIVE
  RETURNED
}

enum TransferStatus {
  REQUESTED
  APPROVED
  REJECTED
}

enum BookingStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MaintenanceStatus {
  PENDING
  APPROVED
  REJECTED
  TECHNICIAN_ASSIGNED
  IN_PROGRESS
  RESOLVED
}

enum AuditCycleStatus {
  OPEN
  CLOSED
}

enum AuditItemResult {
  PENDING
  VERIFIED
  MISSING
  DAMAGED
}

model Employee {
  id                  String         @id @default(cuid())
  name                String
  email               String         @unique
  passwordHash        String
  role                Role           @default(EMPLOYEE)
  status              EmployeeStatus @default(ACTIVE)
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  departmentId        String?
  department          Department?    @relation("DepartmentMembers", fields: [departmentId], references: [id])
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  headOfDepartments   Department[]         @relation("DepartmentHead")
  allocations         AssetAllocation[]    @relation("AllocatedToEmployee")
  requestedTransfers  TransferRequest[]    @relation("TransferRequestedBy")
  approvedTransfers   TransferRequest[]    @relation("TransferApprovedBy")
  bookings            Booking[]            @relation("BookedBy")
  raisedMaintenance   MaintenanceRequest[] @relation("MaintenanceRaisedBy")
  approvedMaintenance MaintenanceRequest[] @relation("MaintenanceApprovedBy")
  createdAuditCycles  AuditCycle[]         @relation("AuditCycleCreatedBy")
  auditorOf           AuditCycleAuditor[]
  verifiedAuditItems  AuditItem[]          @relation("AuditItemVerifiedBy")
  notifications       Notification[]
  activityLogs        ActivityLog[]

  @@index([departmentId])
}

model Department {
  id                 String            @id @default(cuid())
  name               String
  status             DepartmentStatus  @default(ACTIVE)
  headId             String?
  head               Employee?         @relation("DepartmentHead", fields: [headId], references: [id])
  parentDepartmentId String?
  parentDepartment   Department?       @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id])
  subDepartments     Department[]      @relation("DepartmentHierarchy")
  members            Employee[]        @relation("DepartmentMembers")
  allocations        AssetAllocation[] @relation("AllocatedToDepartment")
  transferRequests   TransferRequest[] @relation("TransferToDepartment")
  bookingsOnBehalf   Booking[]         @relation("BookingOnBehalfOfDepartment")
  auditCycles        AuditCycle[]      @relation("AuditCycleScopeDepartment")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([headId])
  @@index([parentDepartmentId])
}

model AssetCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  extraFields Json?
  assets      Asset[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Asset {
  id              String         @id @default(cuid())
  assetTag        String         @unique
  name            String
  categoryId      String
  category        AssetCategory  @relation(fields: [categoryId], references: [id])
  serialNumber    String?
  acquisitionDate DateTime?
  acquisitionCost Decimal?       @db.Decimal(12, 2)
  condition       AssetCondition @default(GOOD)
  location        String?
  photos          String[]       @default([])
  isShared        Boolean        @default(false)
  status          AssetStatus    @default(AVAILABLE)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  allocations         AssetAllocation[]
  transferRequests    TransferRequest[]
  bookings            Booking[]
  maintenanceRequests MaintenanceRequest[]
  auditItems          AuditItem[]

  @@index([categoryId])
  @@index([status])
}

model AssetAllocation {
  id                    String           @id @default(cuid())
  assetId               String
  asset                 Asset            @relation(fields: [assetId], references: [id])
  employeeId            String?
  employee              Employee?        @relation("AllocatedToEmployee", fields: [employeeId], references: [id])
  departmentId          String?
  department            Department?      @relation("AllocatedToDepartment", fields: [departmentId], references: [id])
  allocatedAt           DateTime         @default(now())
  expectedReturnDate    DateTime?
  returnedAt            DateTime?
  conditionCheckinNotes String?
  status                AllocationStatus @default(ACTIVE)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([assetId])
  @@index([employeeId])
  @@index([departmentId])
  @@index([status])
}

model TransferRequest {
  id             String         @id @default(cuid())
  assetId        String
  asset          Asset          @relation(fields: [assetId], references: [id])
  requestedById  String
  requestedBy    Employee       @relation("TransferRequestedBy", fields: [requestedById], references: [id])
  toEmployeeId   String?
  toDepartmentId String?
  toDepartment   Department?    @relation("TransferToDepartment", fields: [toDepartmentId], references: [id])
  status         TransferStatus @default(REQUESTED)
  approvedById   String?
  approvedBy     Employee?      @relation("TransferApprovedBy", fields: [approvedById], references: [id])
  createdAt      DateTime       @default(now())
  resolvedAt     DateTime?

  @@index([assetId])
  @@index([status])
}

model Booking {
  id                     String        @id @default(cuid())
  assetId                String
  asset                  Asset         @relation(fields: [assetId], references: [id])
  bookedById             String
  bookedBy               Employee      @relation("BookedBy", fields: [bookedById], references: [id])
  onBehalfOfDepartmentId String?
  onBehalfOfDepartment   Department?   @relation("BookingOnBehalfOfDepartment", fields: [onBehalfOfDepartmentId], references: [id])
  startTime              DateTime
  endTime                DateTime
  status                 BookingStatus @default(UPCOMING)
  purpose                String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@index([assetId, startTime, endTime])
  @@index([status])
}

model MaintenanceRequest {
  id               String              @id @default(cuid())
  assetId          String
  asset            Asset               @relation(fields: [assetId], references: [id])
  raisedById       String
  raisedBy         Employee            @relation("MaintenanceRaisedBy", fields: [raisedById], references: [id])
  issueDescription String
  priority         MaintenancePriority @default(MEDIUM)
  photoUrl         String?
  status           MaintenanceStatus   @default(PENDING)
  approvedById     String?
  approvedBy       Employee?           @relation("MaintenanceApprovedBy", fields: [approvedById], references: [id])
  technicianName   String?
  resolutionNotes  String?
  createdAt        DateTime            @default(now())
  resolvedAt       DateTime?

  @@index([assetId])
  @@index([status])
}

model AuditCycle {
  id                String           @id @default(cuid())
  name              String
  scopeDepartmentId String?
  scopeDepartment   Department?      @relation("AuditCycleScopeDepartment", fields: [scopeDepartmentId], references: [id])
  scopeLocation     String?
  startDate         DateTime
  endDate           DateTime
  status            AuditCycleStatus @default(OPEN)
  createdById       String
  createdBy         Employee         @relation("AuditCycleCreatedBy", fields: [createdById], references: [id])
  createdAt         DateTime         @default(now())

  auditors AuditCycleAuditor[]
  items    AuditItem[]

  @@index([status])
}

model AuditCycleAuditor {
  auditCycleId String
  auditCycle   AuditCycle @relation(fields: [auditCycleId], references: [id])
  employeeId   String
  employee     Employee   @relation(fields: [employeeId], references: [id])

  @@id([auditCycleId, employeeId])
}

model AuditItem {
  id           String          @id @default(cuid())
  auditCycleId String
  auditCycle   AuditCycle      @relation(fields: [auditCycleId], references: [id])
  assetId      String
  asset        Asset           @relation(fields: [assetId], references: [id])
  result       AuditItemResult @default(PENDING)
  notes        String?
  verifiedById String?
  verifiedBy   Employee?       @relation("AuditItemVerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt   DateTime?

  @@unique([auditCycleId, assetId])
  @@index([auditCycleId])
}

model Notification {
  id         String   @id @default(cuid())
  userId     String
  user       Employee @relation(fields: [userId], references: [id])
  type       String
  message    String
  entityType String?
  entityId   String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId, isRead])
}

model ActivityLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      Employee @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
}
